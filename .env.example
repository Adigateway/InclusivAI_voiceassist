# Copy to .env and fill in. .env is gitignored.
# Local Ollama (default, no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Groq free tier (get a key at https://console.groq.com/keys):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Backup, used automatically when the key above runs out of tokens or fails.
# Can be a second free Groq key, or another OpenAI-compatible provider (then also set BASE_URL and MODEL).
LLM_BACKUP_API_KEY=
# LLM_BACKUP_BASE_URL=https://api.groq.com/openai/v1
# LLM_BACKUP_MODEL=qwen/qwen3.8-27b

# Last resort, runs on this Mac without internet (needs: ollama pull qwen2.5:7b)
LLM_LOCAL_FALLBACK=qwen2.5:7b

# Voice for spoken answers (optional). Samples: Seraphina/Florian/Katja (de), Ava/Andrew/Emma (en)
# TTS_VOICE_DE=de-DE-SeraphinaMultilingualNeural
# TTS_VOICE_EN=en-US-AvaMultilingualNeural
